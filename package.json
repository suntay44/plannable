{
  "name": "plannable",
  "version": "1.0.0",
  "description": "Command-driven planning skill and CLI for AI coding agents.",
  "type": "module",
  "bin": {
    "plannable": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    ".agents/skills/plannable",
    ".codex/skills/plannable",
    ".claude/skills/plannable",
    ".cursor/skills/plannable",
    ".cursor/commands",
    ".cursor/rules",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run package:check",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json}\" \".github/**/*.{yml,yaml}\"",
    "lint": "eslint src tests scripts eslint.config.js vitest.config.ts",
    "package:check": "node scripts/check-package.mjs",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "ai-coding-agents",
    "claude-code",
    "planning",
    "implementation-planning",
    "developer-tools",
    "evidence-gated",
    "cli",
    "codex",
    "claude",
    "cursor"
  ],
  "author": "Christian Patrick Suntay <xtiansun@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suntay44/Plannable.git"
  },
  "homepage": "https://github.com/suntay44/Plannable#readme",
  "bugs": {
    "url": "https://github.com/suntay44/Plannable/issues"
  }
}
